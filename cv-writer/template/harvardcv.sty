% Harvard-style one-page CV layout. Compile with xelatex.
% Letter paper by default; for A4 add \geometry{a4paper} after \usepackage{harvardcv}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{harvardcv}

\RequirePackage[letterpaper, margin=0.5in, top=0.4in, bottom=0.4in]{geometry}
\RequirePackage{fontspec}
\setmainfont{TeX Gyre Termes}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage[hidelinks]{hyperref}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.0}

\titleformat{\section}{\bfseries\large}{}{0pt}{\MakeUppercase}[\vspace{-7pt}\rule{\linewidth}{0.5pt}]
\titlespacing{\section}{0pt}{6pt}{3pt}

\setlist[itemize]{leftmargin=1.3em, itemsep=0pt, topsep=1pt, parsep=0pt, partopsep=0pt, beginpenalty=10000}

% \header{Name}{contact line}
\newcommand{\header}[2]{%
  \begin{center}
    {\fontsize{20}{22}\selectfont\bfseries #1}\\[3pt]
    #2
  \end{center}\vspace{-8pt}}

% \role{Organization}{Dates}{Title}{Location}
\newcommand{\role}[4]{%
  \par\vspace{3pt}\textbf{#1}\hfill #2\\
  \textit{#3}\hfill \textit{#4}\par}

% \shortrole{Organization}{Title}{Dates} -- one line, for older or less relevant jobs
\newcommand{\shortrole}[3]{%
  \par\vspace{1pt}\textbf{#1}, \textit{#2}\hfill #3\par}

% \school{Institution}{Date}{Degree}
\newcommand{\school}[3]{%
  \par\vspace{1pt}\textbf{#1}, #3\hfill #2\par}
